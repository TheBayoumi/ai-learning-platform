{
  "schema_version": 1,
  "policy_id": "github-phase-gate-v1",
  "sources": {
    "roadmap": "specs/roadmap.md",
    "state": "plans/autonomous-loop/state.json",
    "inventory": "plans/implementation-inventory.json",
    "workflow": ".github/workflows/ci.yml"
  },
  "schemas": {
    "state": 3,
    "inventory": 2
  },
  "vocabulary": {
    "lanes": [
      "foundation",
      "validation"
    ],
    "controller_statuses": [
      "READY",
      "RUNNING",
      "IMPLEMENTED_UNVERIFIED",
      "WAITING_EXTERNAL",
      "WAITING_HUMAN",
      "QUOTA_PAUSED",
      "FAILED_RETRYABLE",
      "FAILED_BLOCKED"
    ],
    "track_statuses": [
      "NOT_STARTED",
      "IN_PROGRESS",
      "IMPLEMENTED_UNVERIFIED",
      "PHASE_PASSED",
      "WAITING_EXTERNAL",
      "WAITING_HUMAN",
      "QUOTA_PAUSED",
      "FAILED_RETRYABLE",
      "FAILED_BLOCKED"
    ],
    "inventory_statuses": [
      "NOT_STARTED",
      "IN_PROGRESS",
      "IMPLEMENTED_UNVERIFIED",
      "PASSED",
      "BLOCKED_EXTERNAL",
      "BLOCKED_HUMAN",
      "QUOTA_PAUSED",
      "FAILED_RETRYABLE",
      "FAILED_BLOCKED"
    ],
    "entry_results": [
      "PASSED",
      "FAILED",
      "PENDING"
    ],
    "gate_decisions": [
      "Continue",
      "Revise",
      "Narrow",
      "Stop"
    ],
    "status_projection": {
      "NOT_STARTED": "NOT_STARTED",
      "IN_PROGRESS": "IN_PROGRESS",
      "IMPLEMENTED_UNVERIFIED": "IMPLEMENTED_UNVERIFIED",
      "PASSED": "PHASE_PASSED",
      "BLOCKED_EXTERNAL": "WAITING_EXTERNAL",
      "BLOCKED_HUMAN": "WAITING_HUMAN",
      "QUOTA_PAUSED": "QUOTA_PAUSED",
      "FAILED_RETRYABLE": "FAILED_RETRYABLE",
      "FAILED_BLOCKED": "FAILED_BLOCKED"
    },
    "controller_projection": {
      "NOT_STARTED": "READY",
      "IN_PROGRESS": "RUNNING",
      "IMPLEMENTED_UNVERIFIED": "IMPLEMENTED_UNVERIFIED",
      "PHASE_PASSED": "READY",
      "WAITING_EXTERNAL": "WAITING_EXTERNAL",
      "WAITING_HUMAN": "WAITING_HUMAN",
      "QUOTA_PAUSED": "QUOTA_PAUSED",
      "FAILED_RETRYABLE": "FAILED_RETRYABLE",
      "FAILED_BLOCKED": "FAILED_BLOCKED"
    }
  },
  "phase_rules": {
    "foundation_id_pattern": "^F[0-9]{2}$",
    "validation_id_pattern": "^V[0-9]{2}(?:[A-Z])?$",
    "horizon_id_pattern": "^Q[0-9]+$",
    "dependency_syntax_version": 1,
    "require_passed_dependencies": true,
    "foundation_may_satisfy_validation": false,
    "foundation_requires_human_acceptance": false,
    "validation_lock_roots": [
      "V00",
      "V01"
    ]
  },
  "blocker_catalog": {
    "f03.implementation_checks": "technical",
    "f03.acceptance_revision": "technical",
    "v00.symmetric_demand": "external",
    "v00.practitioner_confirmations": "external",
    "v00.recruitment_channel": "external",
    "v00.measured_cost": "external",
    "f03.local_validation": "technical",
    "f03.independent_verification": "technical"
  },
  "claim_rules": {
    "target_selected": [
      "V00",
      "V01"
    ],
    "partial_profile_evidence": [
      "V16"
    ],
    "beta_entry": [
      "V17B"
    ],
    "external_readiness": [
      "V20"
    ],
    "complete_role_readiness": [
      "V22"
    ]
  },
  "github": {
    "required_checks": [
      "API quality",
      "Web quality",
      "Runtime smoke",
      "Phase gate",
      "Gate projection"
    ],
    "exact_head_required": true,
    "implementation_and_acceptance_heads_required": true,
    "branch": "automation/v00-phase-loop",
    "implementation_pending_condition": "The exact implementation revision passes all five required GitHub jobs",
    "implementation_transition_blockers": [
      "f03.implementation_checks",
      "f03.acceptance_revision"
    ],
    "implementation_transition_missing_outputs": [
      "Exact implementation revision must pass all five required GitHub checks",
      "Separate acceptance-state revision must pass all five required GitHub checks"
    ]
  },
  "limits": {
    "policy_bytes": 131072,
    "state_bytes": 262144,
    "inventory_bytes": 2097152,
    "roadmap_bytes": 524288,
    "workflow_bytes": 262144
  },
  "required_authoritative_hashes": [
    "AGENTS.md",
    "docs/strategy/ai-learning-platform-strategy.md",
    ".github/workflows/ci.yml",
    "specs/mission.md",
    "specs/tech-stack.md",
    "specs/roadmap.md",
    "plans/F03-github-phase-gate-control-plane.md",
    "plans/autonomous-loop/controller-policy.json",
    "plans/autonomous-loop/goal.md",
    "plans/autonomous-loop/checkpoint.md",
    "plans/autonomous-loop/run-log.md",
    "plans/implementation-inventory.json",
    "apps/api/src/ai_learning_platform_api/automation/__init__.py",
    "apps/api/src/ai_learning_platform_api/automation/phase_gate.py",
    "apps/api/tests/test_phase_gate.py",
    "scripts/phase_gate.py",
    "plans/implementation-inventory.md"
  ],
  "state_claim_fields": [
    "product_readiness",
    "role_readiness",
    "validation_satisfied_by_foundation"
  ]
}
