{
  "name": "ai-learning-platform-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=20.9.0 <26",
    "npm": ">=11.18.0 <12"
  },
  "overrides": {
    "postcss": "8.5.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run check:browser-confidentiality",
    "check:browser-confidentiality": "node scripts/check-browser-confidentiality.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/sdk-trace": "2.9.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
