            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Role-neutral technical foundation endpoints only.",
    "title": "AI Career Learning Platform API",
    "version": "0.0.0"
  },
